# .env.example
# Supabase
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Database (Supabase connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Direct DB URL for Prisma migrations
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
# Upstash Redis (for BullMQ and cache)
UPSTASH_REDIS_URL=rediss://:PASSWORD@HOST:PORT
# Twelve Data API
TWELVE_DATA_API_KEY=YOUR_TWELVE_DATA_KEY
# Anthropic (Claude) API
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY
# FX rates (no API key needed for exchangerate.host, but you may provide one)
FX_API_URL=https://api.exchangerate.host/latest?base=INR

